+#[cfg(feature = "vm-stats")]
+fn diagnostic_owned_release_category(eg: &ExecutorGlobals, owner: &Value) -> usize {
+    match owner.value_type() {
+        ValueType::Object => {
+            if owner.cycle_strong_count() != Some(1) { return 2; }
+            let Some(object) = owner.as_object() else { return 1; };
+            let Some(identity) = owner.object_identity() else { return 1; };
+            if object.generator.is_some()
+                || eg.has_weak_object_release_work(identity)
+                || eg.lazy_object_state(owner).is_some()
+                || eg.has_fiber_context(identity)
+                || eg.class_has_destructor(object.class_id, &object.class_name)
+                    && !owner.is_object_destructor_retired()
+            { return 3; }
+            if object.dynamic_properties.is_some() { return 4; }
+            if object.property_values.iter().any(Value::is_reference) { return 5; }
+            if object.property_values.iter().any(|value| match value.value_type() {
+                ValueType::Array | ValueType::Object | ValueType::Closure => true,
+                ValueType::Resource => value.needs_vm_resource_release(),
+                _ => false,
+            }) { 7 } else { 6 }
+        }
+        ValueType::Array => {
+            if owner.cycle_strong_count() != Some(1) { 10 }
+            else if owner.as_array().is_some_and(PhpArray::may_require_nested_release) { 8 }
+            else { 9 }
+        }
+        _ => 0,
+    }
+}
