+#[cfg(feature = "vm-stats")]
+thread_local! {
+    static RELEASE_PROOF: std::cell::Cell<[[u64; 24]; 4]> = const { std::cell::Cell::new([[0; 24]; 4]) };
+}
+#[cfg(feature = "vm-stats")]
+pub(super) fn record_release_proof(site: usize, possible: bool, kind: usize) {
+    RELEASE_PROOF.with(|counts| {
+        let mut current = counts.get();
+        current[site][usize::from(possible) * 12 + kind] += 1;
+        counts.set(current);
+        if site == 0 {
+            let total: u64 = current[site].iter().sum();
+            if total == 1 || total.is_multiple_of(262144) {
+                RELEASE_CLASS_SAMPLES.with(|samples| {
+                    let classes = RELEASE_LIVE_CLASSES.with(|classes| classes.borrow().clone());
+                    samples.borrow_mut().push((total, possible, crate::value::live_release_count_diagnostic(), classes));
+                });
+            }
+        }
+    });
+}
+#[cfg(feature = "vm-stats")]
+fn dump_release_proof() {
+    if std::env::var("RPHP_VM_STATS").as_deref() != Ok("1") { return; }
+    eprintln!("-- global release proof observations --");
+    RELEASE_PROOF.with(|counts| {
+        for (site, row) in counts.get().iter().enumerate() {
+            for (index, count) in row.iter().enumerate() {
+                eprintln!("release_proof_site_{}_possible_{}_kind_{}={}", site, index / 12, index % 12, count);
+            }
+        }
+    });
+}
+
+#[cfg(feature = "vm-stats")]
+thread_local! {
+    static RELEASE_LIVE_CLASSES: std::cell::RefCell<std::collections::BTreeMap<String, usize>> = const { std::cell::RefCell::new(std::collections::BTreeMap::new()) };
+    static RELEASE_CLASS_SAMPLES: std::cell::RefCell<Vec<(u64, bool, usize, std::collections::BTreeMap<String, usize>)>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+#[cfg(feature = "vm-stats")]
+pub(crate) fn record_live_release_class(class: &str, add: bool) {
+    RELEASE_LIVE_CLASSES.with(|classes| {
+        let mut classes = classes.borrow_mut();
+        if add { *classes.entry(class.to_owned()).or_default() += 1; }
+        else if let Some(count) = classes.get_mut(class) {
+            *count -= 1;
+            if *count == 0 { classes.remove(class); }
+        } else { panic!("unmatched diagnostic release tracking"); }
+    });
+}
+#[cfg(feature = "vm-stats")]
+fn dump_release_class_samples() {
+    if std::env::var("RPHP_VM_STATS").as_deref() != Ok("1") { return; }
+    eprintln!("-- global release class samples --");
+    RELEASE_CLASS_SAMPLES.with(|samples| {
+        for (index, (observation, possible, tracked, classes)) in samples.borrow().iter().enumerate() {
+            eprintln!("release_class_sample_{}={}", index, serde_json::json!({"observation":observation,"possible":possible,"tracked":tracked,"classes":classes}));
+        }
+    });
+}
+
+#[cfg(feature = "vm-stats")]
+thread_local! {
+    static OWNED_RELEASE_CURRENT: std::cell::Cell<usize> = const { std::cell::Cell::new(12) };
+    static OWNED_RELEASE_TOTALS: std::cell::Cell<[[u64; 16]; 13]> = const { std::cell::Cell::new([[0; 16]; 13]) };
+}
+#[cfg(feature = "vm-stats")]
+pub(super) struct OwnedReleaseProbeScope(usize);
+#[cfg(feature = "vm-stats")]
+impl Drop for OwnedReleaseProbeScope {
+    fn drop(&mut self) { OWNED_RELEASE_CURRENT.with(|current| current.set(self.0)); }
+}
+#[cfg(feature = "vm-stats")]
+pub(super) fn record_owned_release_root(category: usize, kind: usize) -> OwnedReleaseProbeScope {
+    OWNED_RELEASE_TOTALS.with(|totals| {
+        let mut rows = totals.get(); rows[category][0] += 1; rows[category][1 + kind] += 1; totals.set(rows);
+    });
+    OwnedReleaseProbeScope(OWNED_RELEASE_CURRENT.with(|current| current.replace(category)))
+}
+#[cfg(feature = "vm-stats")]
+pub(super) fn record_owned_release_tree(visits: u64, callbacks: bool) {
+    let category = OWNED_RELEASE_CURRENT.with(std::cell::Cell::get);
+    OWNED_RELEASE_TOTALS.with(|totals| {
+        let mut rows = totals.get(); rows[category][13] += 1; rows[category][14] += visits;
+        rows[category][15] += u64::from(callbacks); totals.set(rows);
+    });
+}
+#[cfg(feature = "vm-stats")]
+fn dump_owned_release_budget() {
+    if std::env::var("RPHP_VM_STATS").as_deref() != Ok("1") { return; }
+    eprintln!("-- owned release budget --");
+    OWNED_RELEASE_TOTALS.with(|totals| {
+        for (category, row) in totals.get().iter().enumerate() {
+            eprintln!("owned_release_category_{}={}", category, serde_json::json!(row));
+        }
+    });
+}
