+// General value graphs use canonical operand/ownership storage. Their finite
+// instruction footprint is independent of unrelated frame capacity.
+#[cfg(feature = "quick-loops")]
+pub(crate) fn build_value_graph(op_array: &OpArray, start: usize) -> Option<MacroPlan> {
+    use crate::vm::instruction::{ASSIGN_CV_MOVE_SOURCE, KNOWN_RESULT_TYPE_MASK};
+    const MAX_VALUE_OPERATIONS: usize = 16;
+    let total = op_array.num_cvs.checked_add(op_array.num_temps)? as usize;
+    let operand_valid = |operand: u16, kind: OpType| match kind {
+        OpType::Const => usize::from(operand) < op_array.literals.len(),
+        OpType::Cv => u32::from(operand) < op_array.num_cvs,
+        OpType::Tmp | OpType::Var => usize::from(operand) >= op_array.num_cvs as usize && usize::from(operand) < total,
+        OpType::Unused => false,
+    };
+    let output_valid = |instruction: &Instruction| matches!(instruction.result_type, OpType::Tmp | OpType::Var)
+        && operand_valid(instruction.result, instruction.result_type);
+    let mut steps = Vec::new();
+    let mut end = start;
+    for ip in start..op_array.instructions.len().min(start.checked_add(MAX_VALUE_OPERATIONS)?) {
+        let instruction = &op_array.instructions[ip];
+        let node_ip = u32::try_from(ip).ok()?;
+        let mut terminal = false;
+        // Keep the existing property/strlen fusion in the canonical executor:
+        // it writes another result slot and owns its exact retirement boundary.
+        if instruction.opcode == OpCode::FetchObjR && op_array.instructions.get(ip + 1).is_some_and(|next|
+            matches!(next.opcode, OpCode::Strlen | OpCode::Strlen_String)
+            && next.op1_type == instruction.result_type && next.op1 == instruction.result) { break; }
+
+        let node = match instruction.opcode {
+            OpCode::FetchObjR if instruction._pad == 0 && output_valid(instruction)
+                && operand_valid(instruction.op1, instruction.op1_type)
+                && operand_valid(instruction.op2, instruction.op2_type) => MacroStep::LoadProperty { ip: node_ip },
+            OpCode::FetchDimR if instruction._pad == 0 && output_valid(instruction)
+                && operand_valid(instruction.op1, instruction.op1_type)
+                && operand_valid(instruction.op2, instruction.op2_type) => MacroStep::LoadDimension { ip: node_ip },
+            OpCode::AssignCv if instruction.op1_type == OpType::Cv
+                && operand_valid(instruction.op1, instruction.op1_type)
+                && instruction.result_type == OpType::Unused
+                && instruction._pad & !ASSIGN_CV_MOVE_SOURCE == 0
+                && operand_valid(instruction.op2, instruction.op2_type) => MacroStep::CopyValue { ip: node_ip },
+            OpCode::Add | OpCode::Add_TmpTmp | OpCode::Add_CvTmp | OpCode::Add_LongLong |
+            OpCode::Sub | OpCode::Sub_CvConst | OpCode::Sub_TmpTmp | OpCode::Sub_LongLong |
+            OpCode::Mul | OpCode::Mod | OpCode::BitwiseAnd | OpCode::BitwiseOr | OpCode::BitwiseXor
+                if instruction._pad & !KNOWN_RESULT_TYPE_MASK == 0 && output_valid(instruction)
+                && operand_valid(instruction.op1, instruction.op1_type)
+                && operand_valid(instruction.op2, instruction.op2_type) => {
+                let kind = match instruction.opcode {
+                    OpCode::Add | OpCode::Add_TmpTmp | OpCode::Add_CvTmp | OpCode::Add_LongLong => OpCode::Add,
+                    OpCode::Sub | OpCode::Sub_CvConst | OpCode::Sub_TmpTmp | OpCode::Sub_LongLong => OpCode::Sub,
+                    other => other,
+                };
+                MacroStep::LongBinary { ip: node_ip, kind }
+            }
+            OpCode::IsEqual | OpCode::IsNotEqual | OpCode::IsSmaller | OpCode::IsSmallerOrEqual
+                if instruction._pad & !KNOWN_RESULT_TYPE_MASK == 0 && output_valid(instruction)
+                && operand_valid(instruction.op1, instruction.op1_type)
+                && operand_valid(instruction.op2, instruction.op2_type) => MacroStep::LongCompare { ip: node_ip, kind: instruction.opcode },
+            OpCode::IsIdentical | OpCode::IsNotIdentical
+                if instruction._pad & !KNOWN_RESULT_TYPE_MASK == 0 && output_valid(instruction)
+                && operand_valid(instruction.op1, instruction.op1_type)
+                && operand_valid(instruction.op2, instruction.op2_type) => MacroStep::IdentityValue {
+                    ip: node_ip, invert: instruction.opcode == OpCode::IsNotIdentical },
+            OpCode::BoolNot | OpCode::Isset
+                if instruction._pad & !KNOWN_RESULT_TYPE_MASK == 0 && output_valid(instruction)
+                && operand_valid(instruction.op1, instruction.op1_type) => {
+                if instruction.opcode == OpCode::BoolNot { MacroStep::NotValue { ip: node_ip } }
+                else { MacroStep::IssetValue { ip: node_ip } }
+            }
+            OpCode::JmpZ | OpCode::JmpNZ if instruction._pad == 0
+                && operand_valid(instruction.op1, instruction.op1_type)
+                && usize::from(instruction.op2) < op_array.instructions.len() => {
+                terminal = true;
+                MacroStep::BranchValue { ip: node_ip, on_true: instruction.opcode == OpCode::JmpNZ }
+            }
+            OpCode::JmpZ_Identical | OpCode::JmpNZ_Identical if instruction._pad == 0
+                && operand_valid(instruction.op1, instruction.op1_type)
+                && operand_valid(instruction.op2, instruction.op2_type)
+                && usize::from(instruction.result) < op_array.instructions.len()
+                && ip + 2 < op_array.instructions.len() => {
+                terminal = true;
+                MacroStep::IdentityBranch { ip: node_ip, on_true: instruction.opcode == OpCode::JmpNZ_Identical }
+            }
+            OpCode::ReleaseTemps if instruction.op1 <= instruction.op2
+                && usize::from(instruction.op2) <= total => MacroStep::ReleaseValues { ip: node_ip },
+            _ => break,
+        };
+        steps.push(node);
+        end = ip;
+        if terminal { break; }
+    }
+    if steps.len() < 2 || end + 1 >= op_array.instructions.len() { return None; }
+    Some(MacroPlan { steps, guard_failures: 0, start_ip: u32::try_from(start).ok()?, end_ip: u32::try_from(end).ok()? })
+}
