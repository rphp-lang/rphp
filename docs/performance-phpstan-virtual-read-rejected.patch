+/// Geometry of one nonescaping owner lifetime. Canonical cache/scope guards
+/// produce the original source; execution projects and retires it without a
+/// physical retain or intermediate frame publication. It never owns callbacks.
+pub struct ReadSnapshotPlan {
+    pub dimension_ip: u32,
+    pub release_ip: u32,
+    pub owner_slot: u16,
+    pub output_slot: u16,
+    pub key: u16,
+    pub key_type: OpType,
+    pub first: u16,
+    pub end: u16,
+}
+
+#[cfg(feature = "quick-loops")]
+pub(crate) fn read_snapshot_occurrences(op_array: &OpArray) -> Vec<u32> {
+    let total = (op_array.num_cvs + op_array.num_temps) as usize;
+    let mut occurrences = vec![0u32; total];
+    for instruction in &op_array.instructions {
+        if instruction.opcode == OpCode::ReleaseTemps {
+            continue;
+        }
+        for (slot, kind) in [
+            (instruction.op1, instruction.op1_type),
+            (instruction.op2, instruction.op2_type),
+            (instruction.result, instruction.result_type),
+        ] {
+            if matches!(kind, OpType::Tmp | OpType::Var)
+                && let Some(count) = occurrences.get_mut(slot as usize)
+            {
+                *count += 1;
+            }
+        }
+        // Conservatively reject every possible hidden scratch reference.
+        // Extended fields often contain unrelated counts/targets; false uses
+        // reduce admission, while no hidden alias may escape this proof.
+        for slot in [
+            Some(instruction.extended_value),
+            instruction.extended_value.checked_sub(1),
+        ]
+        .into_iter()
+        .flatten()
+        {
+            if slot >= op_array.num_cvs
+                && let Some(count) = occurrences.get_mut(slot as usize)
+            {
+                *count += 1;
+            }
+        }
+    }
+    if let Some(slot) = op_array.trait_class_scope_tmp
+        && let Some(count) = occurrences.get_mut(slot as usize)
+    {
+        *count += 1;
+    }
+    occurrences
+}
+
+#[cfg(feature = "quick-loops")]
+pub(crate) fn build_read_snapshot(
+    op_array: &OpArray,
+    ip: usize,
+    occurrences: &[u32],
+) -> Option<ReadSnapshotPlan> {
+    let source = op_array.instructions.get(ip)?;
+    let dimension = op_array.instructions.get(ip.checked_add(1)?)?;
+    let release = op_array.instructions.get(ip.checked_add(2)?)?;
+    op_array.instructions.get(ip.checked_add(3)?)?;
+    let total = op_array.num_cvs.checked_add(op_array.num_temps)?;
+    let temp = |slot: u16, kind: OpType| {
+        matches!(kind, OpType::Tmp | OpType::Var)
+            && u32::from(slot) >= op_array.num_cvs
+            && u32::from(slot) < total
+    };
+    let operand = |slot: u16, kind: OpType| match kind {
+        OpType::Const => usize::from(slot) < op_array.literals.len(),
+        OpType::Cv => u32::from(slot) < op_array.num_cvs,
+        OpType::Tmp | OpType::Var => temp(slot, kind),
+        OpType::Unused => false,
+    };
+    if source.opcode != OpCode::FetchObjR
+        || source._pad != 0
+        || source.extended_value != 0
+        || source.op1_type != OpType::Cv
+        || !operand(source.op1, source.op1_type)
+        || !operand(source.op2, source.op2_type)
+        || !temp(source.result, source.result_type)
+        || occurrences.get(source.result as usize) != Some(&2)
+        || dimension.opcode != OpCode::FetchDimR
+        || dimension._pad != 0
+        || dimension.op1_type != source.result_type
+        || dimension.op1 != source.result
+        || !operand(dimension.op2, dimension.op2_type)
+        || !temp(dimension.result, dimension.result_type)
+        || dimension.result == source.result
+        || release.opcode != OpCode::ReleaseTemps
+        || !(release._pad == 0 || release.is_plain_subexpression_release())
+        || u32::from(release.op1) < op_array.num_cvs
+        || release.op1 > source.result
+        || release.op2 <= source.result
+        || u32::from(release.op2) > total
+    {
+        return None;
+    }
+    Some(ReadSnapshotPlan {
+        dimension_ip: u32::try_from(ip + 1).ok()?,
+        release_ip: u32::try_from(ip + 2).ok()?,
+        owner_slot: source.result,
+        output_slot: dimension.result,
+        key: dimension.op2,
+        key_type: dimension.op2_type,
+        first: release.op1,
+        end: release.op2,
+    })
+}
+
+#[cfg(all(test, feature = "quick-loops"))]
+mod read_snapshot_plan_tests {
+    use super::*;
+    #[test]
+    fn completed_operand_read_lifetime_is_selected_before_statement_assignment() {
+        let mut lexer = crate::lexer::Lexer::new(
+            "<?php function read_snapshot_test($box,$key){$x=$box->data[$key];return $x;}",
+        );
+        let tokens = lexer.tokenize().unwrap();
+        let mut parser = crate::parser::Parser::new(tokens);
+        let ast = parser.parse().unwrap();
+        let result = crate::compiler::compile::Compiler::new()
+            .compile(&ast)
+            .unwrap();
+        let (_, function) = result
+            .functions
+            .into_iter()
+            .find(|(name, _)| name == "read_snapshot_test")
+            .unwrap();
+        assert!(
+            function
+                .op_array
+                .block_plans
+                .iter()
+                .any(|plan| matches!(plan, BlockPlan::ReadSnapshot(_))),
+            "instructions: {:#?}",
+            function.op_array.instructions
+        );
+    }
+}
